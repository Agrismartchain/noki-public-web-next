# Base URL of the NOKI API (no trailing slash), used server-side only by
# src/app/api/track/[token]/route.ts to proxy the public trip-tracking
# endpoint (GET /v1/public/mobility/tracking/:token). Never exposed to the
# browser -- do not add a NEXT_PUBLIC_ prefix to this.
NOKI_API_BASE_URL=http://localhost:3000

# URL of the merchant (seller) portal the public "Sign in" page links to. Leave empty to show "access unavailable".
NOKI_MERCHANT_PORTAL_URL=

# Verified public distribution link for the NOKI Super App (app store page or
# smart link). Used by the home hero and /app page to open/download the app.
# Leave empty: the public site then shows a launch-alert signup instead of a
# fabricated store link.
NOKI_SUPER_APP_URL=
